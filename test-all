#!/usr/bin/env bash
# The platform matrix (PHASE1.md S8, PHASE2.md §0): one command, one exit code.
#
#   ./test-all              every automatic leg
#   ./test-all LEG...       only these legs
#   ./test-all --list       list the legs
#
# Legs:
#   macos        the suite on this Mac (macOS only)
#   alpine       the suite in the pinned Alpine image, scripts/release.conf (arm64 on this host), privileged, plus the pid-reuse
#                race cell; the pidfd probe must use pidfds
#   debian       the suite in the pinned slim image, privileged, plus the pid-reuse race cell
#   amd64        the suite in an emulated amd64 Alpine (image tag sd-amd64-alpine; user space
#                only, the same arm64 kernel: it does NOT test another kernel)
#   pid1         sheepdog as PID 1 of a container: TERM exits 143 (the kernel ignores raise for
#                an init); a TSTP stops the job and then counts as discarded (the job runs on)
#   init         sheepdog under `docker run --init`: TERM exits 143 (it dies of TERM)
#   enosys       the suite under a seccomp profile where pidfd_open fails with ENOSYS; the pidfd
#                probe must fall back to kill
#   sh1          `sh` as PID 1 (no --init): strays --kill skips its live child unless named
#                (cell 29(e))
#   other-user   the suite as an unprivileged user, with a decoy of a third user that must get no
#                signal
#   release      a release build refuses to run in a test environment (PHASE2.md §0.5)
#   dist-linux   install.sh in the pinned Alpine (busybox wget) and slim (no downloader) images:
#                refused with no downloader, installed with wget and with curl, as root and as a
#                user, a checksum mismatch refused (scripts/dist-linux.sh)
#   hardened     the macOS suite against a sheepdog signed ad hoc with the hardened runtime (the
#                runtime notarization needs; PHASE3.md S1); every test binary must have run so
#   bundle       the phase-3 packaging cells on this Mac (tests/dist: the exec door, bundle.sh,
#                the commit override, the npm launcher; PHASE3.md §3)
#   pull         (not automatic) fetch the pinned images from the registry; the one step that
#                reaches it (Docker Desktop may show a keychain prompt for its credential helper)
#   rc           (not automatic) the rc leg: tests/rc against the operator's rc output, read
#                only; SD_RC_DIR=<out>/vX.Y.Z-rc.N and SD_RC_CONTROL_DIR=<same>-control (PHASE3.md §3)
#   tcc          (not automatic) the macOS privacy grant through the PATH symlink: needs an
#                installed release or rc and a click in System Settings; prints the steps
#
# Needs docker for the Linux legs. Every container is started with --rm or removed by the id this
# script recorded; nothing else is ever signalled or removed.
set -uo pipefail
cd "$(dirname "$0")"
ROOT=$PWD
# the pinned images (PHASE3.md D7): the same as the release build. Every `docker run` uses
# --pull=never (a registry call can show a keychain prompt); `./test-all pull` fetches them.
. scripts/release.conf || exit 3
# the amd64 base under its own local name: this Docker store keeps one platform per reference, so
# pulling linux/amd64 of $SD_IMG_ALPINE would make every native leg run amd64 (review, S1 round 3)
AMD64_BASE="sd-amd64-base:$(printf %s "${SD_IMG_ALPINE##*sha256:}" | cut -c1-12)"
AMD64_IMG="sd-amd64-alpine:$(printf %s "${SD_IMG_ALPINE##*sha256:}" | cut -c1-12)"
case $(uname -m) in arm64|aarch64) NATIVE=aarch64 ;; *) NATIVE=$(uname -m) ;; esac
# img_arch IMAGE [PLATFORM]: `uname -m` inside it (never pulls)
img_arch() {
  timeout 60 docker run --rm --pull=never --network none ${2:+--platform "$2"} "$1" uname -m 2>/dev/null
}
ALL="macos alpine debian amd64 pid1 init enosys sh1 other-user release bundle hardened dist-linux"
[ "${1:-}" = "--list" ] && { echo "$ALL pull rc tcc"; exit 0; }
LEGS="${*:-$ALL}"
LOGDIR="${TMPDIR:-/tmp}/sheepdog-test-all.$$"
mkdir -p "$LOGDIR"
declare -a RESULTS=()
CONTAINERS=()
BGPID=""
cleanup() {
  # the step running in the background (see bg_wait): TERM it; GNU timeout passes the TERM on
  # to its whole group (cargo, the test binaries, what they started there), a `docker run`
  # client passes it on to its container. It is our own child, recorded by pid.
  if [ -n "$BGPID" ] && kill -0 "$BGPID" 2>/dev/null; then
    kill -TERM "$BGPID" 2>/dev/null
    local i=0
    while kill -0 "$BGPID" 2>/dev/null && [ $i -lt 450 ]; do sleep 0.1; i=$((i+1)); done
  fi
  for c in "${CONTAINERS[@]:-}"; do [ -n "$c" ] && timeout 60 docker rm -f "$c" >/dev/null 2>&1; done
  # the leg containers, by the id each one wrote to its cidfile
  for f in "$LOGDIR"/*.cid; do [ -s "$f" ] && timeout 60 docker rm -f "$(cat "$f")" >/dev/null 2>&1; done
}
trap cleanup EXIT
# a ctrl-C (INT) or a TERM ends the whole run at once, and the EXIT trap removes the containers.
# Bash runs a trap only when its foreground child ends, and GNU timeout moves itself to a group
# of its own (the terminal's INT never reaches it), so every long step runs in the background
# and bash `wait`s for it: a trapped signal interrupts the wait at once.
trap 'exit 130' INT
trap 'exit 143' TERM

# Run "$@" in the background and wait for it (see the traps above); its exit code. Its pid is
# recorded while it runs, so an interrupt's cleanup can end it (it is in a group of its own).
# Never a pipeline element or inside $(...) (the pid would stay in a subshell), and the command
# gets /dev/null as stdin: nothing run through it may read stdin.
bg_wait() {
  "$@" &
  BGPID=$!
  wait "$BGPID"
  local rc=$?
  BGPID=""
  return $rc
}

record() { RESULTS+=("$1: $2"); echo "== $1: $2"; }

# A tag of its own for each leg (PHASE2.md §0.4): the runner adopts it, so every test process of
# the leg carries SHEEPDOG_TEST_TAG=<it>, and after the suite any live process that still does is
# a leftover, whatever its name.
legtag() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }

# A leg container: --init (so a signal to the container ends it: a shell as PID 1 ignores TERM),
# its id recorded in a cidfile (cleanup removes it even after a timeout or ctrl-C), and bounded.
leg_run() { # leg-name docker-args...
  local name=$1; shift
  rm -f "$LOGDIR/$name.cid"
  bg_wait timeout -k 30 3600 docker run --rm --init --pull=never --cidfile "$LOGDIR/$name.cid" "$@" > "$LOGDIR/$name.log" 2>&1
  local rc=$?
  [ -s "$LOGDIR/$name.cid" ] && timeout 60 docker rm -f "$(cat "$LOGDIR/$name.cid")" >/dev/null 2>&1
  return $rc
}

suite_in() { # image target-dir leg-name [docker args...]
  local img=$1 tgt=$2 name=$3; shift 3
  leg_run "$name" "$@" -e SHEEPDOG_LEG_TAG="$(legtag)" -v "$ROOT":/src:ro -v "$ROOT/$tgt":/tgt "$img" sh /src/scripts/linux-suite.sh
}

leg_macos() {
  [ "$(uname)" = Darwin ] || { record macos "skipped (not macOS)"; return 0; }
  local lt
  lt=$(legtag)
  SHEEPDOG_LEG_TAG=$lt bg_wait timeout -k 30 3600 cargo test --no-fail-fast > "$LOGDIR/macos.log" 2>&1
  local rc=$?
  local left tagged
  # a nested run or a root shim found through the test PATH has argv[0] `sheepdog`
  left=$(ps -Ao args | grep -cE "^($ROOT/target/debug/(sd-fixture|sheepdog run)|sheepdog (run|__root)|/bin/sleep 2[0-9]\.)")
  # and any process that still carries the leg's tag (`ps eww` shows the environment of every
  # process but Apple's platform binaries; the bracket keeps grep's own argv from matching)
  tagged=$(ps eww -A -o pid=,command= | grep -c "SHEEPDOG_TEST_TA[G]=$lt")
  [ $rc -eq 0 ] && [ "$left" -eq 0 ] && [ "$tagged" -eq 0 ] && record macos PASS || record macos "FAIL (rc $rc, leftovers $left, tagged $tagged; $LOGDIR/macos.log)"
}

leg_alpine() {
  suite_in "$SD_IMG_ALPINE" target-linux alpine --privileged -e SD_REUSE_TEST=1 -e SD_LEG_PROBE=pidfd \
    && record alpine PASS || record alpine "FAIL ($LOGDIR/alpine.log)"
}

leg_debian() {
  suite_in "$SD_IMG_SLIM" target-linux-gnu debian --privileged -e SD_REUSE_TEST=1 -e SD_LEG_PROBE=pidfd \
    && record debian PASS || record debian "FAIL ($LOGDIR/debian.log)"
}

leg_amd64() {
  # tagged by the pinned base's digest, so a new pin builds a new image
  local img=$AMD64_IMG a
  if ! timeout 60 docker image inspect "$img" >/dev/null 2>&1; then
    # the Dockerfile goes in a file, never through stdin: bg_wait runs its command in the
    # background, where a non-interactive bash gives it /dev/null as stdin (and a pipe into
    # bg_wait would run it in a subshell, out of cleanup's reach)
    mkdir -p "$LOGDIR/amd64-context"
    printf 'FROM --platform=linux/amd64 %s\nRUN apk add -q procps bash util-linux-misc\n' "$AMD64_BASE" > "$LOGDIR/amd64.Dockerfile"
    # the base is the local amd64 copy `./test-all pull` tags; a missing one fails here instead of
    # a registry call, which can show a keychain prompt
    timeout 60 docker image inspect "$AMD64_BASE" >/dev/null 2>&1 \
      || { record amd64 "FAIL (no local $AMD64_BASE: run ./test-all pull)"; return; }
    bg_wait timeout -k 30 1800 docker build --pull=false --platform linux/amd64 -t "$img" -f "$LOGDIR/amd64.Dockerfile" "$LOGDIR/amd64-context" \
      > "$LOGDIR/amd64-image.log" 2>&1 \
      || { record amd64 "FAIL (image build; $LOGDIR/amd64-image.log)"; return; }
  fi
  a=$(img_arch "$img" linux/amd64)
  [ "$a" = x86_64 ] || { record amd64 "FAIL ($img runs as '$a', not x86_64)"; return; }
  suite_in "$img" target-linux-amd64 amd64 --platform linux/amd64 --privileged -e SD_PS_SHIM=1 \
    && record amd64 PASS || record amd64 "FAIL ($LOGDIR/amd64.log)"
}

# Build the Alpine binaries (for the PID 1 and --init legs) without running the suite.
build_alpine() {
  leg_run build-alpine -v "$ROOT":/src:ro -v "$ROOT/target-linux":/tgt "$SD_IMG_ALPINE" sh -c \
    'rm -rf /w && mkdir /w && cd /src && tar cf - --exclude=./target --exclude="./target-*" --exclude=./spike . | (cd /w && tar xmf -) && cd /w && CARGO_TARGET_DIR=/tgt CARGO_INCREMENTAL=0 cargo build -q --bins'
}

# Start `sheepdog run -- sd-fixture ticker` as the container's main process; prints the id.
# (a command substitution runs this in a subshell: its id goes to a cidfile of its own, which
# cleanup's *.cid glob covers even if the interrupt comes before the caller records it)
start_job() { # extra docker args...
  local cf="$LOGDIR/job-$RANDOM$RANDOM.cid"
  timeout 60 docker run -d --pull=never --cidfile "$cf" "$@" -e SHEEPDOG_TEST_SIGNAL_LOG=/tmp/log -v "$ROOT/target-linux":/tgt:ro "$SD_IMG_ALPINE" \
    /tgt/debug/sheepdog run --quiet -- /tgt/debug/sd-fixture ticker 29.1 /tmp/r
}

job_ready() { # id
  local i=0
  while [ $i -lt 1500 ]; do
    timeout 30 docker exec "$1" sh -c 'test -e /tmp/r.root && [ "$(wc -l < /tmp/r)" -ge 7 ]' 2>/dev/null && return 0
    sleep 0.02; i=$((i+1))
  done
  return 1
}

ticks() { timeout 30 docker exec "$1" sh -c 'wc -l < /tmp/r.tick' 2>/dev/null | tr -d ' '; }

# Every recorded member of the job has a line "<door> <pid> <sig>" in sheepdog's signal log
# (waits up to 10 s).
logged_for_all() { # id sig
  local i=0
  while [ $i -lt 500 ]; do
    timeout 30 docker exec "$1" sh -c 'for p in $(cut -d" " -f1 /tmp/r); do grep -qE "^(pidfd|kill) $p '"$2"'\$" /tmp/log || exit 1; done' 2>/dev/null && return 0
    sleep 0.02; i=$((i+1))
  done
  return 1
}

wait_exit() { # id -> exit code (bounded)
  timeout 60 docker wait "$1" 2>/dev/null
}

leg_pid1() {
  build_alpine || { record pid1 "FAIL (build; $LOGDIR/build-alpine.log)"; return; }
  local c why=""
  c=$(start_job) || { record pid1 "FAIL (start)"; return; }
  CONTAINERS+=("$c")
  job_ready "$c" || why="job not ready"
  local pid1
  pid1=$(timeout 30 docker exec "$c" sh -c 'cat /proc/1/cmdline | tr "\0" " "')
  case "${pid1%% *}" in */sheepdog) ;; *) why="${why:+$why; }PID 1 is not sheepdog: $pid1" ;; esac
  # TSTP: sheepdog stops every member (a STOP in its signal log for each recorded one), then its
  # own stop is ignored (an init: discarded), so it continues each member it stopped (a CONT for
  # each) and the job runs on. Read on readiness: the log lines.
  timeout 30 docker kill -s TSTP "$c" >/dev/null
  if ! logged_for_all "$c" 19; then
    why="${why:+$why; }not every member got a STOP after TSTP"
  fi
  if ! logged_for_all "$c" 18; then
    why="${why:+$why; }not every member got a CONT after the discarded stop"
  fi
  local t1 t2 i=0
  t1=$(ticks "$c")
  while [ $i -lt 250 ]; do t2=$(ticks "$c"); [ -n "$t1" ] && [ -n "$t2" ] && [ "$t2" -gt "$t1" ] && break; sleep 0.02; i=$((i+1)); done
  [ -n "$t1" ] && [ -n "$t2" ] && [ "$t2" -gt "$t1" ] || why="${why:+$why; }the job does not run after TSTP ($t1 -> $t2)"
  timeout 30 docker kill -s TERM "$c" >/dev/null
  local code
  code=$(wait_exit "$c")
  [ "$code" = 143 ] || why="${why:+$why; }TERM exit $code, want 143"
  timeout 30 docker logs "$c" > "$LOGDIR/pid1.log" 2>&1
  [ -z "$why" ] && record pid1 PASS || record pid1 "FAIL ($why)"
}

leg_init() {
  build_alpine || { record init "FAIL (build; $LOGDIR/build-alpine.log)"; return; }
  local c why=""
  c=$(start_job --init) || { record init "FAIL (start)"; return; }
  CONTAINERS+=("$c")
  job_ready "$c" || why="job not ready"
  local pid1
  pid1=$(timeout 30 docker exec "$c" sh -c 'cat /proc/1/cmdline | tr "\0" " "')
  case "${pid1%% *}" in */sheepdog) why="${why:+$why; }PID 1 is sheepdog (no --init?)" ;; esac
  timeout 30 docker kill -s TERM "$c" >/dev/null
  local code
  code=$(wait_exit "$c")
  [ "$code" = 143 ] || why="${why:+$why; }TERM exit $code, want 143"
  [ -z "$why" ] && record init PASS || record init "FAIL ($why)"
}

leg_enosys() {
  local prof="$LOGDIR/seccomp-enosys.json"
  echo '{"defaultAction":"SCMP_ACT_ALLOW","syscalls":[{"names":["pidfd_open"],"action":"SCMP_ACT_ERRNO","errnoRet":38}]}' > "$prof"
  suite_in "$SD_IMG_ALPINE" target-linux enosys --security-opt "seccomp=$prof" -e SD_LEG_PROBE=kill \
    && record enosys PASS || record enosys "FAIL ($LOGDIR/enosys.log)"
}

leg_sh1() {
  build_alpine || { record sh1 "FAIL (build; $LOGDIR/build-alpine.log)"; return; }
  # no --init: the script's shell is PID 1 (the shape under test)
  rm -f "$LOGDIR/sh1.cid"
  bg_wait timeout -k 30 600 docker run --rm --pull=never --cidfile "$LOGDIR/sh1.cid" -v "$ROOT":/src:ro -v "$ROOT/target-linux":/tgt:ro "$SD_IMG_ALPINE" sh /src/scripts/sh1-leg.sh > "$LOGDIR/sh1.log" 2>&1
  local rc=$?
  [ -s "$LOGDIR/sh1.cid" ] && timeout 60 docker rm -f "$(cat "$LOGDIR/sh1.cid")" >/dev/null 2>&1
  [ $rc -eq 0 ] && record sh1 PASS || record sh1 "FAIL ($LOGDIR/sh1.log)"
}

leg_other_user() {
  # --init: the script's shell must not be PID 1 (BusyBox `timeout` execs the command, so a test
  # binary would be a child of PID 1, which a cell that needs an ancestor above it refuses)
  leg_run other-user -v "$ROOT":/src:ro -v "$ROOT/target-linux":/tgt "$SD_IMG_ALPINE" sh /src/scripts/linux-other-user.sh \
    && record other-user PASS || record other-user "FAIL ($LOGDIR/other-user.log)"
}

leg_release() {
  bg_wait timeout -k 30 1800 sh scripts/release-refusal.sh > "$LOGDIR/release.log" 2>&1 \
    && record release PASS || record release "FAIL ($LOGDIR/release.log)"
}

leg_bundle() {
  bg_wait timeout -k 30 3600 sh tests/dist/run.sh > "$LOGDIR/bundle.log" 2>&1 \
    && record bundle PASS || record bundle "FAIL ($LOGDIR/bundle.log)"
}

leg_dist_linux() {
  build_alpine || { record dist-linux "FAIL (build; $LOGDIR/build-alpine.log)"; return; }
  local srv="$LOGDIR/dist-srv" art i ok=1
  art=sheepdog-linux-$NATIVE
  rm -rf "$srv" && mkdir -p "$srv"
  sh scripts/lib/render-install.sh scripts/install.sh 0.0.0 "$srv/install.sh" || { record dist-linux "FAIL (render)"; return; }
  # the README's Docker snippet: its RUN line joined as Docker joins it, and its ARG's version
  awk '/^```dockerfile$/{f=1; next} /^```$/{f=0} f && /^RUN /{r=1} f && r {l=$0; if (sub(/\\$/, "", l)) printf "%s", l; else {print l; r=0}}' README.md \
    | sed 's/^RUN //' > "$srv/readme-run.sh" && sed -n 's/^ARG SHEEPDOG_VERSION=//p' README.md > "$srv/readme-version" \
    && [ -s "$srv/readme-run.sh" ] && [ -s "$srv/readme-version" ] || { record dist-linux "FAIL (no Docker snippet in README.md)"; return; }
  cp "$ROOT/target-linux/debug/sheepdog" "$srv/$art" && (cd "$srv" && shasum -a 256 "$art" > SHA256SUMS) || { record dist-linux "FAIL (serve dir)"; return; }
  for i in "$SD_IMG_ALPINE" "$SD_IMG_SLIM"; do
    echo "== dist-linux in $i" >> "$LOGDIR/dist-linux.log"
    bg_wait timeout -k 30 900 docker run --rm --pull=never -v "$srv":/srv:ro -v "$ROOT/target-linux":/tgt:ro -v "$ROOT/scripts":/scripts:ro \
      "$i" sh /scripts/dist-linux.sh >> "$LOGDIR/dist-linux.log" 2>&1 || ok=0
  done
  # the npm packages on Linux (scripts/dist-linux-npm.sh): packed by npm-pack.sh around these
  # builds, served from static registries; the x64 package runs in the amd64 image, on the amd64
  # leg's build (an x86_64 host has no arm64 build: its arm64 package holds a stand-in, not run)
  local pk="$LOGDIR/dist-npm" other
  case $NATIVE in aarch64) other=linux-x64 ;; *) other=linux-arm64 ;; esac
  rm -rf "$pk" && mkdir -p "$pk/tgz" "$pk/tgz-noplat" "$pk/app/Sheepdog.app/Contents/MacOS" \
    && printf '<plist/>\n' > "$pk/app/Sheepdog.app/Contents/Info.plist" && printf '#!/bin/sh\n' > "$pk/app/Sheepdog.app/Contents/MacOS/sheepdog" \
    && chmod 755 "$pk/app/Sheepdog.app/Contents/MacOS/sheepdog" && sh scripts/lib/archive.sh make "$pk/app/Sheepdog.app" "$pk/mac.tar.gz" \
    && cp "$ROOT/target-linux/debug/sheepdog" "$pk/bin-$( [ $NATIVE = aarch64 ] && echo linux-arm64 || echo linux-x64)" \
    || { record dist-linux "FAIL (npm fixture)"; return; }
  if [ $NATIVE = aarch64 ] && [ -x "$ROOT/target-linux-amd64/debug/sheepdog" ]; then cp "$ROOT/target-linux-amd64/debug/sheepdog" "$pk/bin-$other"
  else printf '#!/bin/sh\necho stand-in\n' > "$pk/bin-$other"; fi
  sh scripts/lib/npm-pack.sh 0.0.0 "$pk/mac.tar.gz" "$pk/bin-linux-arm64" "$pk/bin-linux-x64" npm/sheepdog/bin/sheepdog "$pk/tgz" > /dev/null \
    && cp npm/sheepdog/bin/sheepdog "$pk/launcher" && python3 scripts/lib/static-registry.py "$pk/reg" 4873 "" "$pk/tgz" \
    && cp "$pk/tgz/lukaso-sheepdog-0.0.0.tgz" "$pk/tgz/lukaso-sheepdog-darwin-universal-0.0.0.tgz" "$pk/tgz-noplat/" \
    && python3 scripts/lib/static-registry.py "$pk/reg-noplat" 4874 "" "$pk/tgz-noplat" \
    || { record dist-linux "FAIL (npm packages; $LOGDIR/dist-linux.log)"; return; }
  for i in "$SD_IMG_ALPINE" "$SD_IMG_SLIM"; do
    echo "== dist-linux npm in $i" >> "$LOGDIR/dist-linux.log"
    bg_wait timeout -k 30 1200 docker run --rm --pull=never -v "$pk":/pk:ro -v "$ROOT/scripts":/scripts:ro \
      "$i" sh /scripts/dist-linux-npm.sh >> "$LOGDIR/dist-linux.log" 2>&1 || ok=0
  done
  if [ $NATIVE = aarch64 ]; then
    echo "== dist-linux npm in $AMD64_IMG (linux/amd64)" >> "$LOGDIR/dist-linux.log"
    # the amd64 build must be this tree's: no source newer than it
    local stale; stale=$(find "$ROOT/src" "$ROOT/Cargo.toml" "$ROOT/Cargo.lock" "$ROOT/build.rs" -newer "$ROOT/target-linux-amd64/debug/sheepdog" -type f 2>/dev/null | head -1)
    if [ -x "$ROOT/target-linux-amd64/debug/sheepdog" ] && [ -z "$stale" ] && timeout 60 docker image inspect "$AMD64_IMG" >/dev/null 2>&1; then
      bg_wait timeout -k 30 2400 docker run --rm --pull=never --platform linux/amd64 -v "$pk":/pk:ro -v "$ROOT/scripts":/scripts:ro \
        "$AMD64_IMG" sh /scripts/dist-linux-npm.sh >> "$LOGDIR/dist-linux.log" 2>&1 || ok=0
    else echo "FAIL: the x64 package needs the amd64 leg's build of this tree and its image (./test-all amd64 dist-linux)${stale:+; $stale is newer than the build}" >> "$LOGDIR/dist-linux.log"; ok=0; fi
  fi
  [ $ok = 1 ] && record dist-linux PASS || record dist-linux "FAIL ($LOGDIR/dist-linux.log)"
}

leg_hardened() {
  [ "$(uname -s)" = Darwin ] || { record hardened "skipped (not macOS)"; return; }
  local ev="$LOGDIR/hardened.flags" lt left tagged; : > "$ev"
  lt=$(legtag)
  SHEEPDOG_LEG_TAG=$lt bg_wait env SD_TEST_HARDENED="$ev" timeout -k 30 5400 cargo test --no-fail-fast > "$LOGDIR/hardened.log" 2>&1
  local rc=$?
  # the same leftover checks as the macos leg
  left=$(ps -Ao args | grep -cE "^($ROOT/target/debug/(sd-fixture|sheepdog run)|sheepdog (run|__root)|/bin/sleep 2[0-9]\.)")
  tagged=$(ps eww -A -o pid=,command= | grep -c "SHEEPDOG_TEST_TA[G]=$lt")
  # the evidence: one line per test binary, each with the runtime flag
  local n bins bins_run
  n=$(awk '$2 == "adhoc,runtime"' "$ev" | grep -c .); bins=$(grep -c . "$ev")
  bins_run=$(grep -c '^     Running ' "$LOGDIR/hardened.log")
  if [ $rc = 0 ] && [ "$n" -gt 0 ] && [ "$n" = "$bins" ] && [ "$bins" = "$bins_run" ] && [ "$left" -eq 0 ] && [ "$tagged" -eq 0 ]; then record hardened PASS
  else record hardened "FAIL (rc $rc; $n of $bins signed runs had the runtime flag; $bins_run test binaries; leftovers $left, tagged $tagged; $LOGDIR/hardened.log)"; fi
}

leg_pull() {
  local ok=1 i
  # amd64 first, tagged under its own name; then the native images last, so the pinned
  # references point at the native platform again
  echo "pulling linux/amd64 $SD_IMG_ALPINE (Docker Desktop may ask for keychain access)"
  timeout 1800 docker pull -q --platform linux/amd64 "$SD_IMG_ALPINE" >> "$LOGDIR/pull.log" 2>&1 \
    && timeout 60 docker tag "$SD_IMG_ALPINE" "$AMD64_BASE" || ok=0
  for i in "$SD_IMG_ALPINE" "$SD_IMG_SLIM"; do
    echo "pulling $i"
    timeout 1800 docker pull -q "$i" >> "$LOGDIR/pull.log" 2>&1 || ok=0
  done
  [ "$(img_arch "$SD_IMG_ALPINE")" = "$NATIVE" ] && [ "$(img_arch "$SD_IMG_SLIM")" = "$NATIVE" ] \
    && [ "$(img_arch "$AMD64_BASE" linux/amd64)" = x86_64 ] || { echo "pull: an image has the wrong platform" >> "$LOGDIR/pull.log"; ok=0; }
  [ $ok = 1 ] && record pull PASS || record pull "FAIL ($LOGDIR/pull.log)"
}

leg_rc() {
  [ "$(uname -s)" = Darwin ] || { record rc "FAIL (macOS only)"; return; }
  bg_wait timeout -k 30 3600 env SD_RC_DIR="${SD_RC_DIR:-}" SD_RC_CONTROL_DIR="${SD_RC_CONTROL_DIR:-}" sh tests/rc/run.sh > "$LOGDIR/rc.log" 2>&1 \
    && record rc PASS || record rc "FAIL ($LOGDIR/rc.log)"
}

leg_tcc() {
  cat <<'TXT'
The grant leg needs the operator (PHASE3.md S7), with a release or rc installed by its own
install.sh (so ~/.local/bin/sheepdog links into ~/Applications/Sheepdog.app):
  1. Full Disk Access off for Sheepdog: sheepdog run -- ls ~/Library/Safari   (must be denied)
  2. Turn it on: System Settings > Privacy & Security > Full Disk Access.
  3. The same command through the link: must exit 0.
  4. Off again: denied, with no prompt.
The clean-user half is scripts/s7-clean-user.sh (PHASE3.md S7).
TXT
  record tcc "manual (steps printed)"
}

# the native Linux legs run only if the pinned images really are the native platform. Checked
# before the first such leg (so after a `pull` leg in the same run), then kept.
NATIVE_CHECKED="" NATIVE_BAD=""
native_check() {
  [ -n "$NATIVE_CHECKED" ] && return
  NATIVE_CHECKED=1
  local i a
  for i in "$SD_IMG_ALPINE" "$SD_IMG_SLIM"; do
    a=$(img_arch "$i")
    if [ -z "$a" ]; then NATIVE_BAD="$NATIVE_BAD $i is missing or Docker is unreachable;"
    elif [ "$a" != "$NATIVE" ]; then NATIVE_BAD="$NATIVE_BAD $i runs as '$a' (want $NATIVE; run ./test-all pull);"; fi
  done
}
for leg in $LEGS; do
  case $leg in alpine|debian|pid1|init|enosys|sh1|other-user|dist-linux)
    native_check
    if [ -n "$NATIVE_BAD" ]; then record "$leg" "FAIL (image:$NATIVE_BAD)"; continue; fi ;;
  esac
  case $leg in
    macos) leg_macos ;; alpine) leg_alpine ;; debian) leg_debian ;; amd64) leg_amd64 ;;
    pid1) leg_pid1 ;; init) leg_init ;; enosys) leg_enosys ;; sh1) leg_sh1 ;; other-user) leg_other_user ;;
    release) leg_release ;; bundle) leg_bundle ;; hardened) leg_hardened ;; dist-linux) leg_dist_linux ;; pull) leg_pull ;; rc) leg_rc ;; tcc) leg_tcc ;;
    *) echo "unknown leg: $leg (./test-all --list)"; exit 2 ;;
  esac
done

echo
echo "== summary (logs: $LOGDIR)"
fail=0
for r in "${RESULTS[@]}"; do echo "  $r"; case $r in *FAIL*) fail=1 ;; esac; done
[ $fail -eq 0 ] && echo GREEN || echo RED
exit $fail
