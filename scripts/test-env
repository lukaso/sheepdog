#!/bin/sh
# The cargo runner (.cargo/config.toml, PHASE2.md §0.4). A test binary (one in a `deps`
# directory) runs under `sr-fixture test-env`, which sets the test environment and checks the
# canary and the withheld sink after it; anything else (`cargo run`) runs unchanged.
#
# SR_TEST_HARDENED=FILE (macOS; the `hardened` leg, PHASE3.md S1): before each test binary, sign
# the debug sheepr ad hoc with the hardened runtime and the .dev ID (cargo relinks it on every
# `cargo test`, so it is signed here, after the build), and append its signature flags to FILE,
# the leg's evidence that every test binary ran against a hardened-runtime sheepr.
d=$(dirname "$1")
[ "$(basename "$d")" = deps ] || exec "$@"
f=$(dirname "$d")/sr-fixture
[ -x "$f" ] || { echo "sr-test-env: $f is missing (build the fixture first)" >&2; exit 125; }
if [ -n "${SR_TEST_HARDENED:-}" ]; then
  s=$(dirname "$d")/sheepr
  /usr/bin/codesign -s - -f -o runtime -i com.lukaso.sheepr.dev "$s" 2>/dev/null \
    || { echo "sr-test-env: cannot sign $s with the hardened runtime" >&2; exit 125; }
  flags=$(/usr/bin/codesign -d -v "$s" 2>&1 | sed -n 's/.*flags=[^(]*(\([^)]*\)).*/\1/p')
  echo "$(basename "$1") $flags" >> "$SR_TEST_HARDENED"
  # not passed on: a cell that runs this runner as its subject must see a plain runner
  unset SR_TEST_HARDENED
fi
exec "$f" test-env "$@"
